# Copy to .env.local for local development. In Vercel, add the same keys under
# Project → Settings → Environment Variables. Placeholder values only — never commit real ones.

# --- MongoDB Atlas (required) ---
# Atlas → Database → Connect → Drivers. Keep the user's role scoped to this database.
MONGODB_URI="mongodb://ebadkhan629_db_user:KddCL9OPLObRS9Ap@ac-iwjhjkf-shard-00-00.4luocx5.mongodb.net:27017,ac-iwjhjkf-shard-00-01.4luocx5.mongodb.net:27017,ac-iwjhjkf-shard-00-02.4luocx5.mongodb.net:27017/?ssl=true&replicaSet=atlas-3klt29-shard-0&authSource=admin"
MONGODB_DB="portfolio"

# --- Admin session signing (required) ---
# At least 32 characters. Generate with: openssl rand -base64 48s
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"

# --- Admin provisioning (used ONLY by `npm run admin:create`, never by the running site) ---
# Leave ADMIN_INITIAL_PASSWORD empty to have a strong one generated and printed once.
# Delete ADMIN_INITIAL_PASSWORD after provisioning. Do not add these to Vercel.
ADMIN_EMAIL="you@example.com"
ADMIN_INITIAL_PASSWORD=""

# --- Public site URL (required in production; used for canonical URLs, sitemap, OG) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000/"

# --- Cloudinary image uploads (optional) ---
# Without these, the admin still works with pasted image URLs; the Upload button explains what to set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="portfolio"

# --- Extra image hosts to optimize with next/image (optional, comma separated) ---
# Cloudinary is always optimized. Images from other hosts still display, unoptimized.
IMAGE_REMOTE_HOSTS=""
